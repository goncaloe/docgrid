# Copia para `.env` e ajusta se precisares. O `.env` não é versionado.
# Sem `.env`, tudo funciona com os valores por omissão abaixo.

# Postgres local — usado pelo docker compose e pelo perfil `local`
POSTGRES_DB=docgrid
POSTGRES_USER=docgrid
POSTGRES_PASSWORD=docgrid
POSTGRES_PORT=5432

# LocalStack — as credenciais são fictícias por exigência do próprio LocalStack.
# Não há aqui nenhum segredo: em AWS real, estas variáveis vêm do ambiente de execução.
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_PORT=4566
DOCGRID_BUCKET=docgrid-documents
DOCGRID_QUEUE=docgrid-document-processing
