# Single entry: CloudFront. The API origin must present the X-Origin-Verify header
# (generated by Terraform, carried by CloudFront); actuator stays on the instance.
{
  # Block actuator at the edge: metrics and state are admin territory, reached via SSM.
  @blocked path /actuator/*
  respond @blocked 403

  # Reject anyone without the correct origin-verification header.
  @unverified not header X-Origin-Verify ${verify}
  respond @unverified 403

  reverse_proxy app:8080
}